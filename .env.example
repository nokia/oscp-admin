# Set to true to skip Auth0. Layouts stay authenticated and the access libraries
# return an empty token. Backends must run with AUTH_REQUIRED=false.
VITE_AUTH_DISABLED=true

# Absolute, browser-reachable SSD/SCD URLs. These services may run on another
# host. Docker maps OSCP_* (or these VITE_* names) into config.js at container start.
VITE_OSCP_SSD_URL=http://localhost:8031
VITE_OSCP_SCD_URL=http://localhost:8032

# Auth0 for SSD. Required only when VITE_AUTH_DISABLED is not true.
VITE_AUTH0_SSD_DOMAIN=
VITE_AUTH0_SSD_SCOPE=
VITE_AUTH0_SSD_PROVIDER=
VITE_AUTH0_SSD_AUDIENCE=
VITE_AUTH0_SSD_CLIENTID=

# Auth0 for SCD. Required only when VITE_AUTH_DISABLED is not true.
VITE_AUTH0_SCD_DOMAIN=
VITE_AUTH0_SCD_SCOPE=
VITE_AUTH0_SCD_TENANT=
VITE_AUTH0_SCD_AUDIENCE=
VITE_AUTH0_SCD_CLIENTID=

# Optional Google Drive picker. The button stays disabled when any value is empty.
VITE_GOOGLE_PROJECT_ID=
VITE_GOOGLE_PICKER_KEY=
VITE_GOOGLE_CLIENT_ID=

# Optional PeerJS geopose check. The widget stays disabled when host, port, key, or client URL is empty.
VITE_PEERJS_HOST=
VITE_PEERJS_PORT=
VITE_PEERJS_KEY=
VITE_PEERJS_PATH=/
VITE_PEERJS_CLIENT_URL=

{
    "name": "oscp-admin",
    "version": "0.0.3",
    "scripts": {
        "dev": "vite --host --port 8081",
        "start": "npm run dev",
        "postinstall": "node scripts/patch-routify-esm.cjs",
        "build": "vite build",
        "build:docker": "docker compose build",
        "start:docker": "docker compose up -d",
        "preview": "vite preview --port 8081",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint . --ext .js,.svelte --fix",
        "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,svelte}\""
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenArCloud/oscp-admin"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^3.0.0",
        "@tsconfig/svelte": "^5.0.2",
        "@types/gapi": "^0.0.47",
        "@types/google.picker": "^0.0.42",
        "@types/leaflet": "^1.9.8",
        "@types/qrcode": "^1.5.5",
        "@types/three": "^0.161.2",
        "@vitejs/plugin-basic-ssl": "^1.0.2",
        "buffer": "^5.7.1",
        "deepmerge": "^4.2.2",
        "eslint": "^8.54.0",
        "eslint-config-standard": "^14.1.1",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^4.2.1",
        "eslint-plugin-standard": "^4.1.0",
        "eslint-plugin-svelte": "^2.35.1",
        "geojson2h3": "^1.0.1",
        "googleapis": "^61.0.0",
        "h3-js": "^3.7.2",
        "jwt-decode": "^3.1.2",
        "leaflet": "^1.9.4",
        "peerjs": "^1.5.4",
        "prettier": "^3.1.0",
        "prettier-plugin-svelte": "^3.1.2",
        "qrcode": "^1.4.4",
        "query-string": "^6.13.7",
        "svelte": "^4.2.3",
        "svelte-check": "^3.6.2",
        "svelte-cubed": "^0.2.1",
        "svelte-zondicons": "^1.0.1",
        "three": "^0.161.0",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2",
        "vite": "^5.0.12"
    },
    "dependencies": {
        "@oarc/scd-access": "^0.3.1",
        "@oarc/ssd-access": "^0.3.1",
        "@sveltech/routify": "^1.9.10"
